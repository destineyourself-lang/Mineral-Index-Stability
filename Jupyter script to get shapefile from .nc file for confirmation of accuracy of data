import geopandas as gpd
import xarray as xr
from shapely.geometry import box

NC_PATH = "data_sfc.nc"
CRS_PROJECTED = "EPSG:32611"   # UTM 11N (Nevada)

ds = xr.open_dataset(NC_PATH)

lat_name = "latitude" if "latitude" in ds.coords else "lat"
lon_name = "longitude" if "longitude" in ds.coords else "lon"

lat = float(ds[lat_name].values[0])
lon = float(ds[lon_name].values[0])

print("Grid center:")
print("Latitude:", lat)
print("Longitude:", lon)

# EAC4 grid size = 0.75°
half_size = 0.75 / 2  # 0.375°

xmin = lon - half_size
xmax = lon + half_size
ymin = lat - half_size
ymax = lat + half_size

polygon = box(xmin, ymin, xmax, ymax)

gdf = gpd.GeoDataFrame(
    {"pixel_id": [0],
     "lat_c": [lat],
     "lon_c": [lon]},
    geometry=[polygon],
    crs="EPSG:4326"
)

# Save WGS84 shapefile
gdf.to_file("eac4_single_pixel_wgs84.shp")

# Project and compute area
gdf_proj = gdf.to_crs(CRS_PROJECTED)
gdf_proj["area_km2"] = gdf_proj.area / 1e6

print("Pixel area (km²):", float(gdf_proj["area_km2"]))

gdf_proj.to_file("eac4_single_pixel_projected.shp")

print("Shapefiles saved.")
