# ------------------------------------------------------------
# HELPERS
# ------------------------------------------------------------
def auto_ylim(series):
    s = pd.to_numeric(series, errors="coerce").dropna()
    s = s[s != 0]
    if len(s) == 0:
        return None
    ymin, ymax = float(s.min()), float(s.max())
    pad = (ymax - ymin) * 0.15 if ymax != ymin else (abs(ymin) * 0.1 + 1)
    return ymin - pad, ymax + pad

def make_yaxis_bold(ax):
    # Make y-axis tick labels bold
    for label in ax.get_yticklabels():
        label.set_fontweight("bold")

    # Make scientific offset text bold too (e.g. ×10^−3)
    ax.yaxis.get_offset_text().set_fontweight("bold")

def format_axes(ax):
    ax.xaxis.set_major_locator(mdates.YearLocator())
    ax.xaxis.set_major_formatter(mdates.DateFormatter('%Y'))
    ax.xaxis.set_minor_locator(mdates.MonthLocator())

    ax.tick_params(axis='x', which='major', rotation=45, length=8, width=1.6)
    ax.tick_params(axis='x', which='minor', length=4, width=0.8)

def enforce_equal_plot_area(fig, ax):
    # Fixed margins so plot box width/height stays identical on every chart
    fig.subplots_adjust(left=0.14, right=0.98, bottom=0.18, top=0.88)

    # Keep scientific notation in original units, consistently formatted
    ax.ticklabel_format(axis='y', style='sci', scilimits=(0, 0), useMathText=True)

    # Fixed y-label position so label length does not shift the plot area
    ax.yaxis.set_label_coords(-0.065, 0.5)

    # Keep offset text readable
    ax.yaxis.get_offset_text().set_size(10)

    # Make y-axis values bold
    make_yaxis_bold(ax)

def clean_label(col):
    c = col.lower()
    if "lai" in c:
        return "LAi"
    if "duaod" in c:
        return "CAMS DUAOD"
    if ("cams" in c) and ("aod" in c):
        return "CAMS AOD"
    if "modis" in c and "aod" in c:
        return "MODIS AOD"
    if "ssrd" in c:
        return "SSRD"
    if "slhf" in c:
        return "SLHF"
    if "soil_moisture" in c:
        return "Soil Moisture"
    if "pressure" in c:
        return "Surface Pressure"
    if "humidity" in c:
        return "Absolute Humidity"
    if "evap" in c:
        return "Total Evaporation"
    if "water_vap" in c:
        return "Total Column Water Vapour"
    if "skin" in c:
        return "Skin Temperature"
    if "snow" in c:
        return "Snow"
    if "residual_ndvi" in c:
        return "Residual NDVI"
    if "sza" in c or "solar_zenith" in c:
        return "Solar Zenith Angle"
    if "albedo" in c:
        return "Albedo"
    return col.replace("_", " ")

def remove_band_outliers_iqr(df, band_cols):
    """
    Remove rows having outliers in ANY available band column using IQR rule.
    Applied only to cleaned reflectance charts, not RAW chart.
    This includes B9 when S2_B9_mean is present.
    """
    available = [c for c in band_cols if c in df.columns]
    if not available or len(df) == 0:
        return df.copy()

    keep_mask = pd.Series(True, index=df.index)

    for c in available:
        y = pd.to_numeric(df[c], errors="coerce")
        valid = y.notna()

        if valid.sum() < 4:
            continue

        q1 = y[valid].quantile(0.25)
        q3 = y[valid].quantile(0.75)
        iqr = q3 - q1

        if pd.isna(iqr) or iqr == 0:
            continue

        lower = q1 - 1.5 * iqr
        upper = q3 + 1.5 * iqr

        keep_this = (~valid) | ((y >= lower) & (y <= upper))
        keep_mask &= keep_this

    return df.loc[keep_mask].copy()

# ------------------------------------------------------------
# PLOT: MULTI-BAND
# ------------------------------------------------------------
def plot_multiband(data, title, filename, x_start, x_end):
    fig, ax = plt.subplots(figsize=(15, 5))

    plotted_labels = []

    for b in BANDS:
        col = f"S2_{b}_mean"
        if col not in data.columns:
            continue

        y = pd.to_numeric(data[col], errors="coerce")
        m = y.notna() & (y != 0) & data[DATE_COL].notna()
        if m.sum() == 0:
            continue

        ax.plot(
            data.loc[m, DATE_COL],
            y.loc[m],
            linestyle="None",
            marker="o",
            markersize=2.5,
            label=b,
            color=BAND_COLORS.get(b, None)
        )
        plotted_labels.append(b)

    ax.set_title(title)
    ax.set_ylabel("Reflectance")
    ax.set_xlabel("Date")
    ax.set_xlim(x_start, x_end)

    # Keep original y values, auto scale from actual data
    y_all = []
    for c in BAND_COLS:
        if c in data.columns:
            yy = pd.to_numeric(data[c], errors="coerce")
            yy = yy[(yy.notna()) & (yy != 0)]
            if len(yy) > 0:
                y_all.append(yy)

    if y_all:
        lim = auto_ylim(pd.concat(y_all, axis=0))
        if lim:
            ax.set_ylim(*lim)

    # Consistent y-axis formatter in original units
    formatter = ScalarFormatter(useMathText=True)
    formatter.set_scientific(True)
    formatter.set_powerlimits((0, 0))
    ax.yaxis.set_major_formatter(formatter)

    # Keep legend inside plot area
    if plotted_labels:
        ax.legend(
            ncol=min(len(plotted_labels), 8),
            loc="upper center",
            bbox_to_anchor=(0.5, 0.995),
            frameon=False,
            borderaxespad=0.0
        )

    format_axes(ax)
    enforce_equal_plot_area(fig, ax)

    plt.savefig(OUT_DIR / filename, dpi=300)
    plt.close()

