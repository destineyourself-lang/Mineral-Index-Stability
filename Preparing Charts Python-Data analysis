def plot_parameter(df_clean, col, x_start, x_end):
    if col not in df_clean.columns:
        return None

    data = df_clean.copy()

    # Keep only Sentinel-2A rows for parameter charts
    if PLATFORM_COL in data.columns:
        data = data[
            data[PLATFORM_COL].astype(str).str.contains("2A", case=False, na=False)
        ].copy()

    if len(data) == 0:
        return None

    if "S2_B2_mean" in data.columns:
        mask_b2 = pd.to_numeric(data["S2_B2_mean"], errors="coerce").notna()
        data = data.loc[mask_b2].copy()

    if len(data) == 0:
        return None

    y = pd.to_numeric(data[col], errors="coerce").abs()
    m = y.notna() & (y != 0) & data[DATE_COL].notna()
    if m.sum() == 0:
        return None

    fig, ax = plt.subplots(figsize=(15, 4))
    ax.plot(
        data.loc[m, DATE_COL],
        y.loc[m],
        linestyle="None",
        marker="o",
        markersize=3
    )

    label = clean_label(col)
    ax.set_title(label)
    ax.set_ylabel(label)
    ax.set_xlabel("Date")
    ax.set_xlim(x_start, x_end)

    if "snow" in col.lower():
        ax.set_ylim(0.95, 1.05)
    else:
        lim = auto_ylim(y)
        if lim:
            ax.set_ylim(*lim)

    formatter = ScalarFormatter(useMathText=True)
    formatter.set_scientific(True)
    formatter.set_powerlimits((0, 0))
    ax.yaxis.set_major_formatter(formatter)

    format_axes(ax)
    enforce_equal_plot_area(fig, ax)

    fname = f"{label.replace(' ', '_')}.png"
    out_path = OUT_DIR / fname
    plt.savefig(out_path, dpi=300)
    plt.close()
    return out_path

# ------------------------------------------------------------
# PLOT: CCI + KAI + FII together (ONE chart)
# ------------------------------------------------------------
def plot_cci_kai_fii_together(
    df_clean,
    band_outlier_mask,
    x_start,
    x_end,
    title="S2 Indices (CCI, KAI, FII)",
    filename="S2_CCI_KAI_FII_Together.png"
):
    cols = ["S2_CCI_mean", "S2_KAI_mean", "S2_FII_mean"]
    cols = [c for c in cols if c in df_clean.columns]
    if not cols:
        print("[WARN] None of S2_CCI_mean / S2_KAI_mean / S2_FII_mean found. Skipping combined plot.")
        return None

    colors = {
        "S2_CCI_mean": "tab:blue",
        "S2_KAI_mean": "tab:orange",
        "S2_FII_mean": "tab:green"
    }
    labels = {
        "S2_CCI_mean": "CCI",
        "S2_KAI_mean": "KAI",
        "S2_FII_mean": "FII"
    }

    # Keep only Sentinel-2A rows for parameter/index chart
    data = df_clean.copy()
    local_mask = pd.Series(False, index=data.index)

    if PLATFORM_COL in data.columns:
        local_mask = data[PLATFORM_COL].astype(str).str.contains("2A", case=False, na=False)
    else:
        local_mask = pd.Series(True, index=data.index)

    if "S2_B2_mean" in data.columns:
        mask_b2 = pd.to_numeric(data["S2_B2_mean"], errors="coerce").notna()
    else:
        mask_b2 = pd.Series(True, index=data.index)

    mask_ok = local_mask & mask_b2 & (~band_outlier_mask) & data[DATE_COL].notna()

    fig, ax = plt.subplots(figsize=(15, 4))

    plotted = False
    y_all = []

    for c in cols:
        y = pd.to_numeric(data.loc[mask_ok, c], errors="coerce")
        m = y.notna() & (y != 0)
        if m.sum() == 0:
            continue

        ax.plot(
            data.loc[mask_ok, DATE_COL].loc[m],
            y.loc[m],
            linestyle="None",
            marker="o",
            markersize=3,
            color=colors.get(c, None),
            label=labels.get(c, c)
        )

        y_all.append(y)
        plotted = True

    if not plotted:
        print("[WARN] No valid points for combined CCI/KAI/FII after masking. Skipping.")
        plt.close()
        return None

    ax.set_title(title)
    ax.set_xlabel("Date")
    ax.set_ylabel("Index Value")
    ax.set_xlim(x_start, x_end)

    lim = auto_ylim(pd.concat(y_all, axis=0))
    if lim:
        ax.set_ylim(*lim)

    formatter = ScalarFormatter(useMathText=True)
    formatter.set_scientific(True)
    formatter.set_powerlimits((0, 0))
    ax.yaxis.set_major_formatter(formatter)

    format_axes(ax)
    enforce_equal_plot_area(fig, ax)

    ax.legend(loc="lower right", ncol=3, frameon=True)

    out_path = OUT_DIR / filename
    plt.savefig(out_path, dpi=300)
    plt.close()
    print(f"[OK] Saved combined CCI/KAI/FII: {out_path}")
    return out_path

